---

<section class="faq-container">
    <div class="faq">
        <div class="title">
            <h1> FAQs </h1>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique.</p>
        </dvi>

        <div class="questions">
            {questions.map((question) => {
                return (
                    <div class="qa-box">
                            <button class="qa-header" type="button">
                                <p>{question.q}</p>
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                        aria-hidden="true">
                                        <path d="M12 5v14M5 12h14"/>
                                </svg>
                            </button>

                            <div class="qa-answer">
                                 <p>{question.a}</p>
                            </div>
                    </div>
                    )
            })}
        </div>

        <div class="followup"> 
            <h3>Still have a question?</h3>
            <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. </p>
            <a href="/contact"> Contact </a>
        </div>
    </div>
</section>

<style>
    .faq-container {
        font-family: "Roboto", system-ui, sans-serif;
    }

    .faq {
        display: flex;
        flex-direction: column;
        justfiy-content: center;
        align-items: center;
        margin-top: 3rem;
        margin-bottom: 4rem;
    }

    .title {
        text-align: center;
        max-width: 60%;
    }

    .title h1 {
        font-weight: 700;
        font-size: 3rem;
    }

    .questions {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 4rem;
    }

    .qa-box {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 1rem;
        align-items:flex-start;
        flex-direction: column;
    }

    .qa-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        background: none;
        border: 1px solid black;
        padding: 1rem;
        padding: 0.75rem 1rem;
        cursor: pointer;
    }

    .qa-answer {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
        padding: 0 1rem;
        text-align: left;
        padding: 0 1rem;
        border-left: 1px solid black;
        border-right: 1px solid black;
        border-bottom: 1px solid black;
    }

    .qa-box.open .qa-answer {
        max-height: 200px; 
        padding-bottom: 1rem;
    }

    .qa-box p {
        font-weight: 500;
    }


    .followup {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        align-items: center;
        margin-top: 4rem;
    }

    .followup h3 {
        font-size: 2rem;
        margin: 0;
    }

    .followup p {
        margin: 0;
    }

    .followup a {
        text-decoration: none;
        color: black;
        border: 1px solid black;
        padding: 0.8rem;
        border-radius: 4px;
        width: 20%;
        display: inline-flex;  
        align-items: center;   
        justify-content: center;  
    }

    @media (max-width: 640px) {
        
        .title p {
            text-align: left;
        }

        .title {
            text-align: left;
        }

        .followup a {
        width: 100%;
        text-align: center;
    }
    }

</style>

<script>
  document.querySelectorAll(".qa-header").forEach((button) => {
    button.addEventListener("click", () => {
      const qaBox = button.closest(".qa-box");
      qaBox.classList.toggle("open");
    });
  });
</script>